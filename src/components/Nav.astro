---
// Left sidebar navigation, shared by every page. It owns the sidebar chrome —
// brand, GitHub button, the narrow-screen top bar — and hands the link tree to
// NavLink, which renders itself recursively and carries the link styling.
// Props:
//   current    — slash-separated path of the active link, matched against the
//                `key` at each level: 'home', 'projects/tmux',
//                'projects/tmux/nudge'
//   githubHref — where the GitHub button points (varies per page)
import NavLink from './NavLink.astro';
const { current, githubHref } = Astro.props;
const path = String(current ?? '').split('/');

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // e.g. "/harnessed.dev"
const links = [
  { href: `${base}/`, label: 'Home', key: 'home' },
  {
    href: `${base}/projects`,
    label: 'Projects',
    key: 'projects',
    children: [
      {
        href: `${base}/tmux`,
        label: 'TMUX',
        key: 'tmux',
        children: [
          // Short labels: the full plugin names do not fit at this depth.
          { href: `${base}/sessions-restore`, label: 'Restore', key: 'sessions-restore' },
          { href: `${base}/nudge`, label: 'Nudge', key: 'nudge' },
        ],
      },
      { href: `${base}/taxer`, label: 'TAXER', key: 'taxer' },
    ],
  },
  { href: `${base}/about`, label: 'About', key: 'about' },
];
---
<nav class="sidebar">
  <a class="sidebar-brand" href={`${base}/`}>harnessed</a>
  <div class="sidebar-links">
    {links.map((l) => <NavLink link={l} level={1} path={path} />)}
  </div>
  <a href={githubHref} target="_blank" rel="noopener" class="btn btn-primary sidebar-github">GitHub ↗</a>
</nav>

<style>
  .sidebar {
    flex: none;
    /* Wide enough for the longest level-1 label ("PROJECTS") with its dash and
       chevron; that row is what sets this number. */
    width: 264px;
    align-self: flex-start;
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 36px 28px;
  }
  .sidebar-brand {
    display: none; /* desktop: brand lives at the page top-right (Base.astro) */
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 17px;
    color: var(--color-text);
    text-decoration: none;
  }

  .sidebar-links { display: flex; flex-direction: column; gap: 6px; margin-top: 56px; }

  .sidebar-github { margin-top: auto; align-self: flex-start; white-space: nowrap; }

  @media (max-width: 820px) {
    .sidebar {
      position: static;
      height: auto;
      width: 100%;
      flex-direction: row;
      align-items: center;
      gap: 10px;
      padding: 14px clamp(18px, 5vw, 32px);
      border-right: 0;
      border-bottom: 1px solid var(--color-divider);
    }
    .sidebar-brand { display: block; margin-right: auto; }
    .sidebar-links { flex-direction: row; gap: 4px; margin-top: 0; }
    .sidebar-github { margin-top: 0; }
  }
</style>
