---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // e.g. "/harnessed.dev"

const footerLinks = [
  { href: 'https://github.com/bmohan01/tmux-ai-sessions-restore', label: 'tmux-ai-sessions-restore' },
  { href: 'https://github.com/bmohan01/tmux-nudge', label: 'tmux-nudge' },
  { href: 'https://github.com/bmohan01/Taxer', label: 'Taxer' },
];
---
<Base
  title="Bhargav Mohanty — harnessed"
  current="home"
  githubHref="https://github.com/bmohan01"
  footerLinks={footerLinks}
>
  <section style="padding: 96px 0 72px;">
    <Eyebrow>Personal site</Eyebrow>
    <h1 style="font-family: var(--font-body); font-weight: 400; font-size: 17px; line-height: 1.65; letter-spacing: 0; max-width: 60ch; margin: 0; color: var(--color-text);">
      This is where I (Bhargav Mohanty) keep the things I make, and eventually the things I think about.
    </h1>
    <p style="font-size: 17px; line-height: 1.65; max-width: 60ch; margin: 18px 0 0; color: var(--color-text);">
      <a href={`${base}/projects`} style="color: var(--color-accent); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);">Projects</a> is the section that's live today. What's in it is mostly open-source tooling for working with AI coding agents.
    </p>
  </section>
</Base>
