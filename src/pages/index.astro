---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import PluginCard from '../components/PluginCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // e.g. "/harnessed.dev"

const footerLinks = [
  { href: 'https://github.com/bmohan01/tmux-ai-sessions-restore', label: 'tmux-ai-sessions-restore' },
  { href: 'https://github.com/bmohan01/tmux-nudge', label: 'tmux-nudge' },
  { href: 'https://github.com/bmohan01/Taxer', label: 'Taxer' },
];
---
<Base
  title="harnessed — tools for working with AI coding agents"
  current="home"
  githubHref="https://github.com/bmohan01"
  footerLinks={footerLinks}
>
  <section style="padding: 96px 0 72px;">
    <Eyebrow>AI-agent tooling</Eyebrow>
    <h1 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(40px, 5.6vw, 76px); line-height: 1.08; letter-spacing: -0.015em; margin: 0; margin-left: -0.05em;">
      <span style="display: block;">Tools for working</span>
      <span style="display: block;">with AI coding agents.</span>
    </h1>
    <p style="font-size: 17px; line-height: 1.65; max-width: 60ch; margin: 24px 0 0; color: var(--color-text);">
      Small, sharp tools for engineers who run AI coding agents. Two <strong style="font-weight: 600; color: var(--color-text);">tmux plugins</strong> keep your agent panes resumable and attention-aware — and <strong style="font-weight: 600; color: var(--color-text);">Taxer</strong>, a Claude Code plugin, turns the agent into a local, privacy-first US tax preparer.
    </p>
  </section>

  <hr class="hr" />

  <section style="padding: 64px 0 88px;">
    <details class="disclosure">
      <summary>
        <span class="disclosure-label">tmux plugins</span>
        <svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
      </summary>
      <div class="cards" style="display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 24px;">
        <PluginCard
          href={`${base}/sessions-restore`}
          kicker="tmux-ai-sessions-restore"
          title="Resume the conversation, not just the layout"
          body="Makes claude and kiro-cli chat relaunch resumed, in the same pane, where you left off — after tmux-resurrect brings the pane back."
        />
        <PluginCard
          href={`${base}/nudge`}
          kicker="tmux-nudge"
          title="The pane that needs you, blinking"
          body="Blinks a label on the pane and its status-bar entry the moment it needs a human — an AI agent, a finished build, or anything else."
          blink
        />
      </div>
    </details>

    <details class="disclosure">
      <summary>
        <span class="disclosure-label">Taxer</span>
        <svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
      </summary>
      <div class="cards" style="display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 24px;">
        <PluginCard
          href={`${base}/taxer`}
          kicker="Taxer"
          title="An AI tax preparer that never sees your SSN"
          body="A Claude Code plugin for US taxes — federal plus first-pass state estimates. Claude drives the conversation; a Python engine does every dollar of math; your PII never leaves the device unredacted."
        />
      </div>
    </details>
  </section>

  <style>
    .disclosure { border: 0; }
    .disclosure + .disclosure { margin-top: 24px; }

    .disclosure > summary {
      list-style: none;
      cursor: pointer;
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 0;
      color: var(--color-accent);
      user-select: none;
      -webkit-user-select: none;
      transition: color 0.15s ease;
    }
    .disclosure > summary::-webkit-details-marker { display: none; }
    .disclosure > summary::marker { content: ""; }
    .disclosure > summary::before {
      content: "";
      position: absolute;
      left: -64px;
      top: 50%;
      transform: translateY(-50%);
      width: 44px;
      height: 1px;
      background: var(--color-accent);
    }
    .disclosure > summary:hover { color: var(--color-accent-2); }
    .disclosure > summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }

    .disclosure-label {
      font-size: 13px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .chev { flex: none; transition: transform 0.2s ease; opacity: 0.75; }
    .disclosure[open] > summary .chev { transform: rotate(90deg); }

    .cards { margin-top: 24px; }
    .disclosure[open] > .cards { animation: disclosure-in 0.2s ease both; }
    @keyframes disclosure-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  </style>
</Base>
