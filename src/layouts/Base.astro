---
// Page shell: <head>, Nocturne theme, the gradient background, the centered
// content container, plus the shared Nav and Footer. Pages pass their chrome
// via props and put their sections in the default slot.
//
// Props:
//   title       — <title> text
//   current     — active nav link: 'home' | 'sessions' | 'nudge'
//   githubHref  — GitHub button target in the nav
//   footerLinks — array of { href, label } for the footer
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const { title, current, githubHref, footerLinks } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // e.g. "/harnessed.dev"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <link rel="stylesheet" href={`${base}/styles.css`} />
</head>
<body>
  <div class="app-bg" style="background: radial-gradient(1200px 700px at 84% -160px, color-mix(in srgb, var(--color-accent-900) 75%, transparent), transparent 60%), radial-gradient(1100px 800px at -10% 100%, color-mix(in srgb, black 30%, transparent), transparent 55%), var(--color-bg); min-height: 100vh; color: var(--color-text); font-family: var(--font-body);">
    <div class="layout">
      <Nav current={current} githubHref={githubHref} />
      <main class="main">
        <a class="page-brand" href={`${base}/`}>harnessed</a>
        <div class="content">
          <div class="content-body"><slot /></div>
          <Footer links={footerLinks} />
        </div>
      </main>
    </div>
  </div>

  <style>
    .layout { display: flex; align-items: stretch; min-height: 100vh; }
    .main { flex: 1; min-width: 0; position: relative; display: flex; flex-direction: column; }
    /* Brand pinned to the top-right of the page. */
    .page-brand {
      position: absolute;
      top: 32px;
      right: clamp(24px, 5vw, 64px);
      z-index: 1;
      font-family: var(--font-heading);
      font-weight: var(--font-heading-weight);
      font-size: 17px;
      color: var(--color-text);
      text-decoration: none;
    }
    /* Left padding stays >= 64px so the Eyebrow's -64px accent dash never
       collides with the sidebar; it eases up to 96px on wide screens. */
    .content { flex: 1; display: flex; flex-direction: column; max-width: 1080px; padding: 0 clamp(24px, 5vw, 72px) 0 clamp(72px, 6vw, 96px); }
    /* content-body grows so the Footer is pushed to the bottom of the page. */
    .content-body { flex: 1; }
    @media (max-width: 820px) {
      .layout { flex-direction: column; }
      .page-brand { display: none; }
      .content { margin: 0 auto; padding: 0 clamp(20px, 5vw, 32px); }
    }
  </style>
</body>
</html>
